#!/usr/bin/env bash
# Build a single-file Flatpak bundle for release: dist/westering-x86_64.flatpak
# and its .sha256. Runs on the host, like scripts/flatpak. The names don't carry
# the version, so releases/latest/download/westering-x86_64.flatpak stays put.
source "$(dirname "$0")/lib.sh"
require_host
cd "$ROOT"
lock_builder

REPO="$ROOT/.flatpak-repo"
DIST="$ROOT/dist"

if [[ Cargo.lock -nt flatpak/cargo-sources.json ]]; then
  scripts/cargo-sources
fi

systemd-run --user --scope --quiet --collect \
  -p MemoryMax=6G -p MemorySwapMax=2G \
  flatpak run --user org.flatpak.Builder \
    --user --force-clean --ccache \
    --state-dir="$ROOT/.flatpak-builder" \
    --repo="$REPO" \
    "$ROOT/build" flatpak/"$APP_ID".yml

mkdir -p "$DIST"
flatpak build-bundle \
  --runtime-repo=https://dl.flathub.org/repo/flathub.flatpakrepo \
  "$REPO" "$DIST/westering-x86_64.flatpak.part" "$APP_ID"
mv -f "$DIST/westering-x86_64.flatpak.part" "$DIST/westering-x86_64.flatpak"
(cd "$DIST" && sha256sum westering-x86_64.flatpak > westering-x86_64.flatpak.sha256)
echo "Built $DIST/westering-x86_64.flatpak ($(cut -d ' ' -f 1 "$DIST/westering-x86_64.flatpak.sha256"))"
